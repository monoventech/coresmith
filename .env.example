AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

INERTIA_SSR_PORT=13717
VITE_APP_NAME="${APP_NAME}"
VITE_INERTIA_SSR_PORT="${INERTIA_SSR_PORT}"

REVERB_APP_ID=coresmith
REVERB_APP_KEY=coresmith-local
REVERB_APP_SECRET=
