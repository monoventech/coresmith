{
    "admin": {
        "listen": "unix//run/caddy-admin/admin.sock|0222"
    },
    "logging": {
        "logs": {
            "default": {
                "writer": {
                    "filename": "/var/log/caddy/access.log",
                    "output": "file"
                },
                "encoder": {
                    "format": "json"
                },
                "exclude": ["http.log.access.log0", "http.log.access.log1"]
            },
            "log0": {
                "writer": {
                    "filename": "/var/log/caddy/coresmith-panel.log",
                    "output": "file",
                    "roll_keep": 5,
                    "roll_size_mb": 10
                },
                "encoder": {
                    "format": "json"
                },
                "include": ["http.log.access.log0"]
            },
            "log1": {
                "writer": {
                    "filename": "/var/log/caddy/coresmith-panel.log",
                    "output": "file",
                    "roll_keep": 5,
                    "roll_size_mb": 10
                },
                "encoder": {
                    "format": "json"
                },
                "include": ["http.log.access.log1"]
            }
        }
    },
    "apps": {
        "http": {
            "servers": {
                "srv0": {
                    "listen": ["127.0.0.1:8484"],
                    "routes": [
                        {
                            "match": [
                                {
                                    "host": ["127.0.0.1"]
                                }
                            ],
                            "handle": [
                                {
                                    "handler": "subroute",
                                    "routes": [
                                        {
                                            "handle": [
                                                {
                                                    "handler": "vars",
                                                    "root": "/opt/coresmith/app/public"
                                                }
                                            ]
                                        },
                                        {
                                            "group": "group2",
                                            "handle": [
                                                {
                                                    "handler": "subroute",
                                                    "routes": [
                                                        {
                                                            "handle": [
                                                                {
                                                                    "handler": "static_response",
                                                                    "headers": {
                                                                        "Location": [
                                                                            "{http.request.orig_uri.path}/{http.request.orig_uri.prefixed_query}"
                                                                        ]
                                                                    },
                                                                    "status_code": 308
                                                                }
                                                            ],
                                                            "match": [
                                                                {
                                                                    "file": {
                                                                        "try_files": [
                                                                            "{http.request.uri.path}/index.php"
                                                                        ]
                                                                    },
                                                                    "not": [
                                                                        {
                                                                            "path": ["*/"]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "handle": [
                                                                {
                                                                    "handler": "rewrite",
                                                                    "uri": "{http.matchers.file.relative}"
                                                                }
                                                            ],
                                                            "match": [
                                                                {
                                                                    "file": {
                                                                        "split_path": [".php"],
                                                                        "try_files": [
                                                                            "{http.request.uri.path}",
                                                                            "{http.request.uri.path}/index.php",
                                                                            "index.php"
                                                                        ],
                                                                        "try_policy": "first_exist_fallback"
                                                                    }
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "handle": [
                                                                {
                                                                    "handler": "reverse_proxy",
                                                                    "transport": {
                                                                        "protocol": "fastcgi",
                                                                        "resolve_root_symlink": true,
                                                                        "split_path": [".php"]
                                                                    },
                                                                    "upstreams": [
                                                                        {
                                                                            "dial": "unix//run/php/coresmith-panel-fpm.sock"
                                                                        }
                                                                    ]
                                                                }
                                                            ],
                                                            "match": [
                                                                {
                                                                    "path": ["*.php"]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "path": ["/api/up/release"]
                                                }
                                            ]
                                        },
                                        {
                                            "group": "group2",
                                            "handle": [
                                                {
                                                    "handler": "subroute",
                                                    "routes": [
                                                        {
                                                            "handle": [
                                                                {
                                                                    "handler": "static_response",
                                                                    "headers": {
                                                                        "Location": [
                                                                            "{http.request.orig_uri.path}/{http.request.orig_uri.prefixed_query}"
                                                                        ]
                                                                    },
                                                                    "status_code": 308
                                                                }
                                                            ],
                                                            "match": [
                                                                {
                                                                    "file": {
                                                                        "try_files": [
                                                                            "{http.request.uri.path}/index.php"
                                                                        ]
                                                                    },
                                                                    "not": [
                                                                        {
                                                                            "path": ["*/"]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "handle": [
                                                                {
                                                                    "handler": "rewrite",
                                                                    "uri": "{http.matchers.file.relative}"
                                                                }
                                                            ],
                                                            "match": [
                                                                {
                                                                    "file": {
                                                                        "split_path": [".php"],
                                                                        "try_files": [
                                                                            "{http.request.uri.path}",
                                                                            "{http.request.uri.path}/index.php",
                                                                            "index.php"
                                                                        ],
                                                                        "try_policy": "first_exist_fallback"
                                                                    }
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "handle": [
                                                                {
                                                                    "handler": "reverse_proxy",
                                                                    "transport": {
                                                                        "protocol": "fastcgi",
                                                                        "resolve_root_symlink": true,
                                                                        "split_path": [".php"]
                                                                    },
                                                                    "upstreams": [
                                                                        {
                                                                            "dial": "unix//run/php/coresmith-panel-fpm.sock"
                                                                        }
                                                                    ]
                                                                }
                                                            ],
                                                            "match": [
                                                                {
                                                                    "path": ["*.php"]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "path": ["/api/caddy/ask"]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "static_response",
                                                    "status_code": 404
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ],
                            "terminal": true
                        }
                    ],
                    "automatic_https": {
                        "skip": ["127.0.0.1"]
                    }
                },
                "srv1": {
                    "listen": [":443"],
                    "routes": [
                        {
                            "match": [
                                {
                                    "host": ["coresmith.example.com"]
                                }
                            ],
                            "handle": [
                                {
                                    "handler": "subroute",
                                    "routes": [
                                        {
                                            "handle": [
                                                {
                                                    "handler": "vars",
                                                    "root": "/opt/coresmith/app/public"
                                                },
                                                {
                                                    "handler": "headers",
                                                    "response": {
                                                        "deferred": true,
                                                        "delete": ["Server"],
                                                        "set": {
                                                            "Permissions-Policy": [
                                                                "camera=(), microphone=(), geolocation=()"
                                                            ],
                                                            "Referrer-Policy": ["strict-origin-when-cross-origin"],
                                                            "Strict-Transport-Security": [
                                                                "max-age=31536000; includeSubDomains; preload"
                                                            ],
                                                            "X-Content-Type-Options": ["nosniff"],
                                                            "X-Frame-Options": ["DENY"]
                                                        }
                                                    }
                                                },
                                                {
                                                    "encodings": {
                                                        "gzip": {},
                                                        "zstd": {}
                                                    },
                                                    "handler": "encode",
                                                    "prefer": ["gzip", "zstd"]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "reverse_proxy",
                                                    "upstreams": [
                                                        {
                                                            "dial": "127.0.0.1:6001"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "path": ["/app/*", "/apps/*"]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "static_response",
                                                    "headers": {
                                                        "Location": [
                                                            "{http.request.orig_uri.path}/{http.request.orig_uri.prefixed_query}"
                                                        ]
                                                    },
                                                    "status_code": 308
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "file": {
                                                        "try_files": ["{http.request.uri.path}/index.php"]
                                                    },
                                                    "not": [
                                                        {
                                                            "path": ["*/"]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "rewrite",
                                                    "uri": "{http.matchers.file.relative}"
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "file": {
                                                        "split_path": [".php"],
                                                        "try_files": [
                                                            "{http.request.uri.path}",
                                                            "{http.request.uri.path}/index.php",
                                                            "index.php"
                                                        ],
                                                        "try_policy": "first_exist_fallback"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "reverse_proxy",
                                                    "transport": {
                                                        "protocol": "fastcgi",
                                                        "resolve_root_symlink": true,
                                                        "split_path": [".php"]
                                                    },
                                                    "upstreams": [
                                                        {
                                                            "dial": "unix//run/php/coresmith-panel-fpm.sock"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "path": ["*.php"]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "file_server",
                                                    "hide": ["/tmp/cs-fixture/panel.caddy"]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ],
                            "terminal": true
                        },
                        {
                            "match": [
                                {
                                    "host": ["old.example.net"]
                                }
                            ],
                            "handle": [
                                {
                                    "handler": "subroute",
                                    "routes": [
                                        {
                                            "handle": [
                                                {
                                                    "handler": "static_response",
                                                    "headers": {
                                                        "Location": ["https://coresmith.example.com{http.request.uri}"]
                                                    },
                                                    "status_code": 301
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ],
                            "terminal": true
                        },
                        {
                            "handle": [
                                {
                                    "handler": "subroute",
                                    "routes": [
                                        {
                                            "handle": [
                                                {
                                                    "handler": "vars",
                                                    "root": "/opt/coresmith/app/public"
                                                },
                                                {
                                                    "handler": "headers",
                                                    "response": {
                                                        "deferred": true,
                                                        "delete": ["Server"],
                                                        "set": {
                                                            "Permissions-Policy": [
                                                                "camera=(), microphone=(), geolocation=()"
                                                            ],
                                                            "Referrer-Policy": ["strict-origin-when-cross-origin"],
                                                            "Strict-Transport-Security": ["max-age=31536000"],
                                                            "X-Content-Type-Options": ["nosniff"],
                                                            "X-Frame-Options": ["DENY"]
                                                        }
                                                    }
                                                },
                                                {
                                                    "encodings": {
                                                        "gzip": {},
                                                        "zstd": {}
                                                    },
                                                    "handler": "encode",
                                                    "prefer": ["gzip", "zstd"]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "reverse_proxy",
                                                    "upstreams": [
                                                        {
                                                            "dial": "127.0.0.1:6001"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "path": ["/app/*", "/apps/*"]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "static_response",
                                                    "headers": {
                                                        "Location": [
                                                            "{http.request.orig_uri.path}/{http.request.orig_uri.prefixed_query}"
                                                        ]
                                                    },
                                                    "status_code": 308
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "file": {
                                                        "try_files": ["{http.request.uri.path}/index.php"]
                                                    },
                                                    "not": [
                                                        {
                                                            "path": ["*/"]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "rewrite",
                                                    "uri": "{http.matchers.file.relative}"
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "file": {
                                                        "split_path": [".php"],
                                                        "try_files": [
                                                            "{http.request.uri.path}",
                                                            "{http.request.uri.path}/index.php",
                                                            "index.php"
                                                        ],
                                                        "try_policy": "first_exist_fallback"
                                                    }
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "reverse_proxy",
                                                    "transport": {
                                                        "protocol": "fastcgi",
                                                        "resolve_root_symlink": true,
                                                        "split_path": [".php"]
                                                    },
                                                    "upstreams": [
                                                        {
                                                            "dial": "unix//run/php/coresmith-panel-fpm.sock"
                                                        }
                                                    ]
                                                }
                                            ],
                                            "match": [
                                                {
                                                    "path": ["*.php"]
                                                }
                                            ]
                                        },
                                        {
                                            "handle": [
                                                {
                                                    "handler": "file_server",
                                                    "hide": ["/tmp/cs-fixture/panel.caddy"]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ],
                            "terminal": true
                        }
                    ],
                    "tls_connection_policies": [{}],
                    "logs": {
                        "default_logger_name": "log1",
                        "logger_names": {
                            "coresmith.example.com": ["log0"]
                        },
                        "skip_hosts": ["old.example.net"]
                    }
                }
            }
        },
        "tls": {
            "automation": {
                "policies": [
                    {
                        "subjects": ["coresmith.example.com", "old.example.net"],
                        "issuers": [
                            {
                                "email": "ops@example.com",
                                "module": "acme"
                            },
                            {
                                "ca": "https://acme.zerossl.com/v2/DV90",
                                "email": "ops@example.com",
                                "module": "acme"
                            }
                        ]
                    },
                    {
                        "issuers": [
                            {
                                "email": "ops@example.com",
                                "module": "acme"
                            },
                            {
                                "ca": "https://acme.zerossl.com/v2/DV90",
                                "email": "ops@example.com",
                                "module": "acme"
                            }
                        ],
                        "on_demand": true
                    }
                ],
                "on_demand": {
                    "permission": {
                        "endpoint": "http://127.0.0.1:8484/api/caddy/ask",
                        "module": "http"
                    }
                }
            }
        }
    }
}
