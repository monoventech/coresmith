{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "generate": "bun public/scripts/generate-manifest.ts && bun public/scripts/generate-service-worker.ts",
        "build": "bun run generate && vite build",
        "build:ssr": "bun run build && vite build --ssr",
        "dev": "bun run generate && vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "svelte-check --tsconfig ./tsconfig.json",
        "shadcn:update": "bunx shadcn-svelte update --all"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/svelte": "^3.1.1",
        "@inertiajs/vite": "^3.1.1",
        "@internationalized/date": "^3.12.1",
        "@lucide/svelte": "^1.14.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/table-core": "^8.21.3",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^25.7.0",
        "bits-ui": "^2.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.2.1",
        "embla-carousel-svelte": "^8.6.0",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-svelte": "^3.17.1",
        "formsnap": "^2.0.1",
        "globals": "^17.6.0",
        "laravel-vite-plugin": "^3.1.0",
        "layerchart": "2.0.0-next.48",
        "lucide-svelte": "^1.0.1",
        "maildev": "^2.2.1",
        "mode-watcher": "^1.1.0",
        "paneforge": "^1.0.2",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.55.5",
        "svelte-check": "^4.4.8",
        "svelte-portal": "^2.2.1",
        "svelte-sonner": "^1.1.1",
        "svelte-transition": "^0.0.17",
        "sveltekit-superforms": "^2.30.1",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.3",
        "vaul-svelte": "^1.0.0-next.7",
        "vite": "^8.0.12",
        "vite-plugin-eslint": "^1.8.1",
        "ziggy-js": "^2.6.2",
        "zod": "^4.4.3"
    }
}
