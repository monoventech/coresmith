{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "coresmith",
    "version": "0.1.0",
    "description": "Coresmith — self-hostable server management and deployment platform",
    "license": "Elastic-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate": "bun public/scripts/generate-manifest.ts && bun public/scripts/generate-service-worker.ts",
        "build": "bun run generate && vite build",
        "build:ssr": "bun run build && vite build --ssr",
        "dev": "bun run generate && vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "svelte-check --tsconfig ./tsconfig.json",
        "shadcn:update": "bunx shadcn-svelte update --all",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "e2e:refresh": "php artisan migrate:fresh --seed --seeder=E2ESeeder --env=e2e --force",
        "e2e:install-refresh": "php artisan migrate:fresh --env=e2e-install --force && php artisan coresmith:setup-token --env=e2e-install --force",
        "e2e:cloud-refresh": "php artisan migrate:fresh --seed --seeder=CloudE2ESeeder --env=e2e-cloud --force",
        "lint:sh": "shellcheck -S style scripts/*.sh tests/Machine/*.sh",
        "lint:tailwind": "node scripts/tailwind-canonical.mjs",
        "lint:tailwind:fix": "node scripts/tailwind-canonical.mjs --write"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@inertiajs/svelte": "^3.8.0",
        "@inertiajs/vite": "^3.8.0",
        "@internationalized/date": "^3.12.4",
        "@lucide/svelte": "^1.52.0",
        "@playwright/test": "^1.63.0",
        "@sentry/svelte": "^11.4.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/table-core": "^8.21.3",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^26.6.4",
        "axe-core": "^4.14.0",
        "bits-ui": "^2.19.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-svelte": "^3.23.0",
        "formsnap": "^2.0.1",
        "globals": "^17.13.0",
        "laravel-echo": "^2.5.0",
        "laravel-vite-plugin": "^3.2.0",
        "layerchart": "2.5.1",
        "maildev": "^3.0.0",
        "mode-watcher": "^1.1.0",
        "paneforge": "^1.0.2",
        "prettier": "^3.9.9",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "pusher-js": "^8.6.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "svelte-portal": "^2.2.1",
        "svelte-sonner": "^1.2.1",
        "svelte-transition": "^0.0.17",
        "sveltekit-superforms": "^2.31.0",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vaul-svelte": "^1.0.0-next.7",
        "vite": "^8.3.3",
        "vite-plugin-eslint": "^1.8.1",
        "ziggy-js": "^2.6.4",
        "zod": "^4.6.5"
    }
}
