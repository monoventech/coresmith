{
    "preset": "laravel",
    "rules": {
        "not_operator_with_successor_space": false,
        "concat_space": {
            "spacing": "one"
        },
        "function_declaration": {
            "closure_fn_spacing": "none",
            "closure_function_spacing": "one"
        },
        "types_spaces": {
            "space": "none",
            "space_multiple_catch": "single"
        },
        "method_chaining_indentation": false
    }
}
